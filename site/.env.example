# URL publique du site (sans / final), ex. https://hairbysd.ch
SITE_URL=http://localhost:3000

# Mot de passe de l'espace /admin
ADMIN_PASSWORD=change-moi

# Base de données Postgres (Neon, Vercel Postgres, Supabase...). Vide = fichier local (développement seulement).
DATABASE_URL=

# Stripe (Dashboard > Développeurs > Clés API). Vide = mode démo (aucun vrai paiement).
STRIPE_SECRET_KEY=
# Secret du webhook Stripe (Dashboard > Développeurs > Webhooks), événements checkout.session.completed et checkout.session.expired
STRIPE_WEBHOOK_SECRET=
