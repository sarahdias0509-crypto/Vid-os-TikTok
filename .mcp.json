{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@0.0.85",
        "--headless", "--no-sandbox", "--isolated",
        "--executable-path", "/opt/pw-browsers/chromium"
      ]
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.40.0"],
      "env": { "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-fc-placeholder-injected-by-proxy}" }
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.3.0"],
      "env": { "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-pplx-placeholder-injected-by-proxy}" }
    }
  }
}
