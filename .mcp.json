{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--no-sandbox",
        "--isolated",
        "--executable-path",
        "/opt/pw-browsers/chromium"
      ]
    },
    "perplexity": {
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server@1.3.0"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-pplx-placeholder-injected-by-proxy}"
      }
    }
  }
}
